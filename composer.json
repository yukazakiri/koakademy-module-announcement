{
    "name": "koakademy/announcement",
    "description": "School-wide announcements for administrators and portal users.",
    "homepage": "https://github.com/yukazakiri/koakademy-module-announcement",
    "keywords": [
        "koakademy",
        "school-management",
        "announcement"
    ],
    "support": {
        "issues": "https://github.com/yukazakiri/koakademy-module-announcement/issues",
        "source": "https://github.com/yukazakiri/koakademy-module-announcement"
    },
    "type": "library",
    "license": "AGPL-3.0-or-later",
    "authors": [
        {
            "name": "KoAkademy contributors"
        }
    ],
    "require": {
        "php": ">=8.5.12 <8.6",
        "filament/filament": "^5.0",
        "laravel/framework": "^13.0",
        "nwidart/laravel-modules": "^13.0",
        "spatie/laravel-permission": "^6.21",
        "coolsam/modules": "^5.0",
        "inertiajs/inertia-laravel": "^3.0"
    },
    "require-dev": {
        "pestphp/pest": "^5.0"
    },
    "autoload": {
        "psr-4": {
            "Modules\\Announcement\\": "app/",
            "Modules\\Announcement\\Database\\Factories\\": "database/factories/",
            "Modules\\Announcement\\Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Modules\\Announcement\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Modules\\Announcement\\Providers\\AnnouncementServiceProvider"
            ]
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "wikimedia/composer-merge-plugin": true
        }
    },
    "scripts": {
        "test": "pest --compact tests/Unit/PackageContractTest.php"
    }
}
